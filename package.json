{
  "name": "vitacura-comunidad-segura-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "camera:up": "node scripts/camera-gateway.mjs up",
    "camera:down": "node scripts/camera-gateway.mjs down",
    "camera:status": "node scripts/camera-gateway.mjs status",
    "camera:logs": "node scripts/camera-gateway.mjs logs",
    "camera:docker:up": "docker compose -f docker-compose.camera.yml up -d",
    "camera:docker:down": "docker compose -f docker-compose.camera.yml down",
    "data:build": "node build-data.mjs",
    "data:audit": "node auditar-dashboard.mjs",
    "data:verify": "node scripts/verify-scenarios.mjs",
    "data:export-mongo": "node scripts/export-mongo-scenario.mjs",
    "data:verify-mongo": "node scripts/verify-mongo-export.mjs",
    "performance:verify": "node scripts/verify-bundle.mjs",
    "check": "npm run data:audit && npm run data:verify && npm run build && npm run performance:verify"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "hls.js": "^1.7.0",
    "maplibre-gl": "^5.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
